^^ Fix 5 (error): ordering operators used on whole sequences.

gene nucleus()
    "ACGT" -> dna g
    when "AC" < "GT"          ^^ error: multi-base literals
        report g
    stop
    when tail(g) > 'A'        ^^ error: tail() is a sequence
        report g
    stop
    when (fuse g g) <= 'C'    ^^ error: fuse builds a sequence
        report g
    stop
    cycle i across g
        when i >= 'A'         ^^ error: loop counter is an integer
            report g
        stop
    stop
stop
